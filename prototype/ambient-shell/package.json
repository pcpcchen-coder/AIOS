{
  "name": "nous-ambient-shell-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Nous 原型：漂浮電子腦 + 交辦任務 + 按需呈現進度（獨立資料夾，非 G0 驗收）",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "vite build && tsx server/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vision:setup": "node scripts/vision-setup.mjs",
    "docs:commands": "tsx scripts/write-commands-doc.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "dompurify": "3.4.16",
    "marked": "18.0.14"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
