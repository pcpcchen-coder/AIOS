# 複製成 .env 後填入。.env 已被 .gitignore 排除，不會進版控。

# Anthropic API key（必填才會由 Claude 真的執行；未填則為「模擬模式」）
ANTHROPIC_API_KEY=

# 選填：指定模型 id。未填時於第一個任務經 Models API 取得最新的 NOUS_MODEL_FAMILY 系列模型。
# NOUS_MODEL=
# NOUS_MODEL_FAMILY=opus

# 選填：強制模式 claude | mock
# NOUS_EXECUTOR=

# 選填：伺服器端 refusal fallback（beta），預設 on；所選模型不支援時設為 off
# NOUS_FALLBACKS=on

# 選填：同時執行的任務數（預設 2）與連接埠（預設 8787）
# NOUS_MAX_CONCURRENT=2
# PORT=8787
