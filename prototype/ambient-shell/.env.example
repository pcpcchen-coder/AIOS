# 複製成 .env 後填入。.env 已被 .gitignore 排除，不會進版控。

# Anthropic API key（要用 Claude 引擎才需要）
ANTHROPIC_API_KEY=

# OpenAI API key（要用即時語音模式才需要；像 ChatGPT 語音模式，語音直接對語音、可插話）
# 到 https://platform.openai.com/api-keys 申請，依用量計費。只留在本機核心，不會送到瀏覽器。
# 交辦的工作仍用上面選的引擎執行。未填時「開始語音對話」沿用瀏覽器語音辨識＋ChatGPT 文字回覆。
OPENAI_API_KEY=

# 選填：即時語音的模型與聲音
# NOUS_REALTIME_MODEL=gpt-realtime
# NOUS_REALTIME_VOICE=marin

# 選填：即時語音的上網查詢（天氣、新聞、價格等即時資料），用同一把 OPENAI_API_KEY 呼叫 web_search。
# NOUS_SEARCH_MODEL=gpt-5.5
# NOUS_SEARCH_COUNTRY=TW
# NOUS_SEARCH_TIMEZONE=Asia/Taipei

# 選填：掛到即時語音的遠端 MCP 伺服器（JSON 陣列，必須是 https）。
# require_approval 預設 always：會改變外部狀態的工具，執行前在畫面上確認。唯讀工具可設 never。
# NOUS_REALTIME_MCP=[{"server_label":"calendar","server_url":"https://example.com/mcp","authorization":"TOKEN","require_approval":"always"}]

# 選填：背景任務上網搜尋（預設 on）；Claude 引擎使用的 web search 工具版本。
# NOUS_TASK_WEB_SEARCH=on
# NOUS_CLAUDE_WEB_SEARCH=web_search_20250305

# AI 引擎：claude | chatgpt | mock。只決定第一次啟動的預設；之後在畫面說「設定」切換，選擇會保存。
# ChatGPT 不需要 key：在設定畫面按「Continue with ChatGPT」用瀏覽器登入（使用你的 ChatGPT 方案額度）。
# NOUS_PROVIDER=

# 選填：ChatGPT 模型 slug。未填時用帳號模型清單（/v1/models）的第一個。
# NOUS_CHATGPT_MODEL=

# 選填：ChatGPT 登入憑證與設定的存放目錄（預設 ~/.config/nous，權限 0600，不會進 repo）
# NOUS_CONFIG_DIR=

# 選填：Sign in with ChatGPT 的本機回呼埠（預設 1455；被占用時自動改用其他埠）
# NOUS_OAUTH_PORT=1455

# 選填：指定模型 id。未填時於第一個任務經 Models API 取得最新的 NOUS_MODEL_FAMILY 系列模型。
# NOUS_MODEL=
# NOUS_MODEL_FAMILY=opus


# 選填：伺服器端 refusal fallback（beta），預設 on；所選模型不支援時設為 off
# NOUS_FALLBACKS=on

# 選填：同時執行的任務數（預設 4，超過的會排隊、輪到時自動開始）與連接埠（預設 8787）
# NOUS_MAX_CONCURRENT=4
# PORT=8787

# 選填：雙目鏡頭（docs/11，Waveshare AR0144，macOS 上名稱為 CCB Camera）。影像只在本機處理，不保存、不上傳。
# 先執行一次 npm run vision:setup 下載本機視覺模型。
# NOUS_CAMERA=on
# NOUS_CAMERA_LABEL=CCB Camera
# 併排影像左半是否為左眼（實測確認前預設 true）
# NOUS_CAMERA_LEFT_FIRST=true
# 有人在場且面向螢幕 1.2 秒就自動開始即時語音（需已同意過即時語音）
# NOUS_LOOK_TO_TALK=on
# 螢幕寬度與鏡頭到螢幕中心的垂直距離（mm），用於手臂指向
# NOUS_SCREEN_WIDTH_MM=398
# NOUS_CAMERA_OFFSET_MM=140

# 選填：武陵居中控（docs/12 H0，唯讀查詢）。設定後即時語音可回答「客廳現在幾度」這類問題。
# 權杖到中控「系統接入」建立；只留在本機核心，不送瀏覽器、不送 OpenAI。目前不能用語音控制家電。
# 中控與 Nous 在同一台電腦時用 127.0.0.1；分開時改成中控的區網 IP。
# SMARTHOME_URL=http://127.0.0.1:8788
# SMARTHOME_TOKEN=
